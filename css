
body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #f4f6f9;
    color: #333;
    margin: 0;
    padding: 0;
    line-height: 1.6;
}


.header-container {
    background-color: #2c3e50;
    color: #ffffff;
    text-align: center;
    padding: 30px 20px;
}

.main-title {
    margin: 0;
    font-size: 2.2em;
}

.subtitle {
    margin-top: 5px;
    font-size: 1.1em;
    color: #bdc3c7;
}


.header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 800px;
    margin: 0 auto;
}

.burger-btn {
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: white;
    display: block;
    padding: 5px 10px;
}

.nav-menu {
    display: none; /* ซ่อนเมนูไว้ก่อน */
    flex-direction: column;
    gap: 0;
    background-color: #1a252f;
    width: 100%;
    margin-top: 15px;
}

.nav-menu.show {
    display: flex; /* แสดงเมื่อมี class show */
}

.nav-menu a {
    text-decoration: none;
    color: white;
    font-weight: 500;
    padding: 12px 20px;
    display: block;
    border-bottom: 1px solid #2c3e50;
}

.nav-menu a:hover {
    background-color: #3498db;
}


.content-container {
    max-width: 800px;
    margin: 20px auto;
    padding: 0 20px;
}


.cv-section {
    background: #ffffff;
    padding: 20px 25px;
    margin-bottom: 25px;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}

.section-title {
    color: #2c3e50;
    border-bottom: 2px solid #3498db;
    padding-bottom: 8px;
    margin-top: 0;
}


.lab-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: 15px;
    margin: 20px 0;
    padding: 20px;
    background: #ecf0f1;
    border-radius: 8px;
    border: 1px solid #dcdde1;
}


.computer-card {
    padding: 20px 10px;
    text-align: center;
    border-radius: 8px;
    font-size: 1.1em;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
    user-select: none;
    box-shadow: 0 3px 6px rgba(0,0,0,0.1);
}


.computer-card.available {
    background-color: #2ecc71;
    color: white;
}

.computer-card.available:hover {
    background-color: #27ae60;
    transform: translateY(-3px);
    box-shadow: 0 5px 12px rgba(46, 204, 113, 0.3);
}


.computer-card.booked {
    background-color: #e74c3c;
    color: white;
    cursor: not-allowed;
    opacity: 0.65;
}


.computer-card.selected {
    background-color: #f39c12;
    color: white;
    transform: scale(1.08);
    box-shadow: 0 0 0 3px #d35400, 0 6px 15px rgba(243, 156, 18, 0.4);
}


.status-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 15px;
    font-size: 0.95em;
    font-weight: 500;
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
}

.dot-icon {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    display: inline-block;
}

.dot-available { background-color: #2ecc71; }
.dot-booked { background-color: #e74c3c; }
.dot-selected { background-color: #f39c12; }


.custom-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
}

.custom-table th, .custom-table td {
    border: 1px solid #ddd;
    padding: 12px;
    text-align: left;
}

.custom-table th {
    background-color: #3498db;
    color: white;
}

.custom-table tr:nth-child(even) {
    background-color: #f9f9f9;
}


.btn-cancel {
    background-color: #e74c3c;
    color: white;
    border: none;
    padding: 6px 12px;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    transition: background 0.2s;
}

.btn-cancel:hover {
    background-color: #c0392b;
}


.contact-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group label {
    margin-bottom: 5px;
    font-weight: bold;
}

.form-input {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 1em;
}

.form-textarea {
    resize: vertical;
}

.submit-btn {
    background-color: #27ae60;
    color: white;
    padding: 12px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1em;
    font-weight: bold;
    transition: background-color 0.3s;
}

.submit-btn:hover {
    background-color: #219150;
}


.footer-container {
    text-align: center;
    padding: 20px;
    background-color: #2c3e50;
    color: white;
    margin-top: 30px;
}


#scrollTopBtn {
    display: none;
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 99;
    font-size: 18px;
    border: none;
    outline: none;
    background-color: #3498db;
    color: white;
    cursor: pointer;
    padding: 10px 15px;
    border-radius: 50%;
    box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    transition: background-color 0.3s, transform 0.2s;
}

#scrollTopBtn:hover {
    background-color: #2980b9;
    transform: scale(1.1);
}


@media (max-width: 600px) {
    .lab-layout {
        grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
        gap: 10px;
        padding: 10px;
    }

    .computer-card {
        padding: 15px 5px;
        font-size: 0.95em;
    }

    .status-legend {
        flex-direction: column;
        gap: 8px;
    }
}
